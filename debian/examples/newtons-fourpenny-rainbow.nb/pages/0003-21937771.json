     "typ": "text",
     "cre": "1666-02-03T11:00:00.000",
     "mod": "1666-02-03T11:00:00.000",
     "uuid": "16f19edf",
     "text": "To-morrow I shall write to the Royal Society. Mr Hooke shall be delighted vexed. Excellent.",
